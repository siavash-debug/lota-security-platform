# ==============================================================================
# LOTA SECURITY PLATFORM - LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# WARNING: ALL CREDENTIALS AND VALUES IN THIS FILE ARE FOR LOCAL DEVELOPMENT ONLY.
# NEVER USE THESE VALUES IN STAGING OR PRODUCTION ENVIRONMENTS.
# ==============================================================================

# Global Environment Configuration
LOTA_ENV=development
LOTA_LOG_LEVEL=INFO
LOTA_REDACTION_ENABLED=true

# Verity API Gateway Configuration
VERITY_API_HOST=127.0.0.1
VERITY_API_PORT=8000
VERITY_API_SECRET_KEY=dev-only-insecure-secret-key-replace-in-production-32chars

# Verity Worker Configuration
VERITY_WORKER_CONCURRENCY=2
VERITY_WORKER_WORKSPACE=/tmp/lota-workspace

# PostgreSQL Metadata Store (Development Only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lota_verity_dev
POSTGRES_USER=verity_dev_user
POSTGRES_PASSWORD=dev_only_verity_password_insecure

# Redis Job Queue (Development Only)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dev_only_redis_password_insecure

# MinIO Evidence Store Substitute (Development Only)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=minio_dev_admin
MINIO_ROOT_PASSWORD=dev_only_minio_password_insecure
MINIO_BUCKET_EVIDENCE=verity-evidence-dev

# Open Policy Agent (Development Only)
OPA_URL=http://127.0.0.1:8181/v1/data/posture
