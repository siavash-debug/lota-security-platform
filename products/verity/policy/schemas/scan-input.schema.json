{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lota.security/schemas/policy/scan-input.json",
  "title": "ScanPolicyInput",
  "description": "Normalized input document evaluated by Open Policy Agent Rego posture bundles.",
  "type": "object",
  "version": "1.0.0",
  "required": ["asset", "controls", "container"],
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Schema version"
    },
    "asset": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "environment": { "type": "string" }
      }
    },
    "controls": {
      "type": "object",
      "properties": {
        "public_admin_exposure": { "type": "boolean" },
        "mfa_required": { "type": "boolean" },
        "api_keys_over_90_days": { "type": "integer", "minimum": 0 }
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "run_as_root": { "type": "boolean" },
        "docker_socket_mounted": { "type": "boolean" },
        "privileged": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
