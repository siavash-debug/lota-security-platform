# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.rego text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.env.example text eol=lf
Makefile text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.tar binary
*.gz binary
